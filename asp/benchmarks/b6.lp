% veicoli: Id, Lunghezza, Orientamento
% stato iniziale: S, Id, X, Y

veicolo(1, 2, orizzontale). % macchina rossa
stato(1, 1, 1, 3). 

veicolo(2, 3, verticale). % camion giallo
stato(1, 2, 3, 2).

veicolo(3, 2, verticale). % macchina verde chiaro
stato(1, 3, 6, 2).

veicolo(4, 2, verticale). % macchina arancione
stato(1, 4, 1, 4).

veicolo(5, 2, orizzontale). % macchina azzurra
stato(1, 5, 4, 4).

veicolo(6, 3, verticale). % camion viola
stato(1, 6, 6, 4).

veicolo(7, 2, orizzontale). % macchina rosa
stato(1, 7, 2, 5).

veicolo(8, 2, verticale). % macchina viola
stato(1, 8, 4, 5).

veicolo(9, 2, verticale). % macchina rosa
stato(1, 9, 5, 5).

veicolo(10, 3, orizzontale). % camion verde
stato(1, 10, 1, 6).