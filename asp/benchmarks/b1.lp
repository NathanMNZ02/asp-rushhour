% Definizione posizioni dei camion

truck(3, 1, vertical). % origine in 3, 1 e orientato verticalmente
truck(1, 4, horizontal). % origine in 1, 4 e orientato orizzontalmente
truck(6, 4, vertical). % origine in 6, 4 e orientato verticalmente

% Definizione posizioni delle auto

car(5, 1, horizontal). % origine in 5, 1 e orientato orizzontalmente

% Definizione della posizione dell'auto rossa

red_car(1, 3, horizontal). % origine 1, 3 e orientato orizzontalmente