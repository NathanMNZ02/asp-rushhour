% veicoli: Id, Lunghezza, Orientamento
% stato iniziale: S, Id, X, Y

veicolo(1, 2, orizzontale). % macchina rossa
stato(1, 1, 1, 3). 

veicolo(2, 3, orizzontale). % camion viola
stato(1, 2, 1, 2).

veicolo(3, 3, orizzontale). % camion giallo
stato(1, 3, 3, 1).

veicolo(4, 3, verticale). % camion blu
stato(1, 4, 5, 2).

veicolo(5, 3, orizzontale). % camion verde
stato(1, 5, 1, 4).

veicolo(6, 2, verticale). % macchina verde
stato(1, 6, 6, 3).

veicolo(7, 2, verticale). % macchina arancione
stato(1, 7, 1, 5).

veicolo(8, 2, verticale). % macchina azzurra
stato(1, 8, 3, 5).

veicolo(9, 2, orizzontale). % macchina rosa
stato(1, 9, 5, 5).

veicolo(10, 2, orizzontale). % macchina viola
stato(1, 10, 5, 6).