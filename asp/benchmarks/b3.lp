% veicoli: Id, Lunghezza, Orientamento
% stato iniziale: S, Id, X, Y

veicolo(1, 2, orizzontale). % macchina rossa
stato(1, 1, 1, 3). 

veicolo(2, 2, verticale). % macchina verde chiaro
stato(1, 2, 1, 1).

veicolo(3, 2, verticale). % macchina arancione
stato(1, 3, 2, 1).

veicolo(4, 2, orizzontale). % macchina azzurra
stato(1, 4, 3, 1).

veicolo(5, 2, orizzontale). % macchina viola
stato(1, 5, 3, 2).

veicolo(6, 2, verticale). % macchina rosa
stato(1, 6, 5, 1).

veicolo(7, 2, verticale). % macchina verde scuro
stato(1, 7, 3, 3).

veicolo(8, 2, verticale). % macchina grigia
stato(1, 8, 3, 5).

veicolo(9, 3, verticale). % camion giallo
stato(1, 9, 4, 3).

veicolo(10, 2, verticale). % macchina grigia
stato(1, 10, 5, 4).